# Optional: path to Desktop OAuth client JSON (default: credentials/client_secrets.json)
# GOOGLE_OAUTH_CLIENT_SECRETS=/path/to/client_secrets.json

# Server port (default in app is 5001 — avoids macOS AirPlay on 5000 showing HTTP 403)
# PORT=5001

# Local “Photos on this computer”: suffix appended to image/JSON basenames when the UI checkbox is on.
# Leave empty so the default is same-name output (overwrite-friendly when saving back to a folder).
# WEB_OUTPUT_IMAGE_SUFFIX=_exif

SECRET_KEY=change-me-for-production

# Hours exported photos stay available for download before they are deleted (default 24).
# JOB_RETENTION_HOURS=24
